<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleExecutable</key><string>eViacam-YuNet</string>
  <key>CFBundleIdentifier</key><string>org.eviacam.yunet</string>
  <key>CFBundleName</key><string>eViacam YuNet</string>
  <key>CFBundleDisplayName</key><string>eViacam YuNet</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>${PROJECT_VERSION}</string>
  <key>CFBundleVersion</key><string>2.1.4</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSCameraUsageDescription</key><string>eViacam analyse localement les mouvements de votre visage pour déplacer le pointeur. Aucune image n’est envoyée sur Internet.</string>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>LSMinimumSystemVersion</key><string>${CMAKE_OSX_DEPLOYMENT_TARGET}</string>
</dict></plist>
